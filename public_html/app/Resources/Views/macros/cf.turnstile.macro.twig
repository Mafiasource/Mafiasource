{% macro turnstile(class = '', isolated = false, instance = 'default') %}
    {% if isolated %}
        <input type="hidden" id="cf-turnstile-response-{{ instance }}" name="cf-turnstile-response" value="isolated" />
    {% else %}
        <div id="cf-turnstile-{{ instance }}" class="{{ class }}"></div>
        <input type="hidden" id="cf-turnstile-response-{{ instance }}" name="cf-turnstile-response" />
    {% endif %}
{% endmacro %}

{% macro turnstileScript(siteKey = '', isolated = false, protectedForm = '', instance = 'default') %}
    {% if not isolated %}
    <script type="text/javascript">
        (function () {
            const containerId = 'cf-turnstile-{{ instance|e('js') }}';
            const responseId = 'cf-turnstile-response-{{ instance|e('js') }}';
            const protectedForm = {% if protectedForm %}document.querySelector("{{ protectedForm|e('js') }}"){% else %}null{% endif %};
            const submitButton = protectedForm !== null ? protectedForm.querySelector('[type="submit"]') : null;
            let rendered = false;

            function renderTurnstile() {
                const container = document.getElementById(containerId);
                if (rendered === true || container === null) {
                    return;
                }

                rendered = true;
                turnstile.render(container, {
                    sitekey: "{{ siteKey|e('js') }}",
                    callback: function (token) {
                        const responseField = document.getElementById(responseId);
                        if (responseField !== null) {
                            responseField.value = token;
                        }
                        if (submitButton !== null) {
                            submitButton.disabled = false;
                        }
                    },
                    'expired-callback': function () {
                        const responseField = document.getElementById(responseId);
                        if (responseField !== null) {
                            responseField.value = '';
                        }
                        if (submitButton !== null) {
                            submitButton.disabled = true;
                        }
                    }
                });
            }

            if (typeof window.turnstile !== 'undefined') {
                renderTurnstile();
                return;
            }

            window.mafiasourceTurnstileCallbacks = window.mafiasourceTurnstileCallbacks || [];
            window.mafiasourceTurnstileCallbacks.push(renderTurnstile);
            window.onloadMafiasourceTurnstile = function () {
                const callbacks = window.mafiasourceTurnstileCallbacks.splice(0);
                callbacks.forEach(function (callback) {
                    callback();
                });
            };

            if (document.getElementById('cf-turnstile-api') === null) {
                const script = document.createElement('script');
                script.id = 'cf-turnstile-api';
                script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js?onload=onloadMafiasourceTurnstile&render=explicit';
                script.defer = true;
                document.head.appendChild(script);
            }
        }());
    </script>
    {% endif %}
{% endmacro %}
